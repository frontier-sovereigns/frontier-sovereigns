# Local host configuration. See README.md for setup and endpoint diagnostics.
# Copy to a local .env excluded from source control. Do not place secrets in VITE_*.
NODE_ENV=production
GAME_BIND=127.0.0.1
GAME_PORT=3000
# Set to the actual origin used by browsers; blank uses the host's default origins.
# Host bootstrap remains available only through the direct loopback page.
GAME_PUBLIC_ORIGIN=
GAME_ALLOWED_ORIGINS=
GAME_DATA_DIR=./runtime-data
GAME_LAN_MODE=false
GAME_PAUSE_WHEN_NO_HUMANS=true
# Persistent compute pools. Integer 0..8; 0 is the inline reference/debug lane.
# Keep spare cores for Windows, browser rendering and the existing local model.
FRONTIER_PATH_WORKERS=2
# Used by the optional 50 ms profile; 300 ms keeps incremental contact visibility local.
FRONTIER_VISION_WORKERS=2
# Optional visibility threads for 300 ms frames. Default inline; enable only
# after a representative comparison (contact-phase IPC can increase latency).
FRONTIER_COARSE_VISION_WORKERS=0
# 1: dedicated recipient-view encoding worker (default); 0: inline reference lane.
FRONTIER_PUBLICATION_WORKER=1
# adaptive: quietly reduce wall-clock game speed under sustained overload (default).
# pause: retain normal speed at the selected frame cadence and pause above 2 s debt.
FRONTIER_OVERLOAD_POLICY=adaptive
# Empty: generate a short-lived, loopback-only first-run admin bootstrap token.
# Never ship a common default admin password.
HOST_ADMIN_BOOTSTRAP_TOKEN=

# Optional AI: leave blank for rule-based commanders. Configure models in host controls.
# A local example base URL is http://127.0.0.1:8080/v1; the model ID must match your server.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# generic_openai_compatible | llama_cpp | vllm
AI_PROVIDER_PROFILE=generic_openai_compatible
AI_MAX_CONCURRENT=5
AI_TIMEOUT_SECONDS=45
AI_INPUT_TOKEN_BUDGET=2500
AI_MAX_OUTPUT_TOKENS=512
AI_INTERVAL_EASY_SECONDS=60
AI_INTERVAL_MEDIUM_SECONDS=45
AI_INTERVAL_HARD_SECONDS=30
AI_MAX_ADAPTIVE_INTERVAL_SECONDS=120
AI_TEMPERATURE=0.2
AI_SEND_HUMAN_CHAT=true
# Host-controlled provider parameters, validated through the selected adapter.
# Do not blindly forward arbitrary user-provided JSON.
AI_PROVIDER_OPTIONS_JSON={}

# Normal-speed authority cadence: 300 ms baseline; 50 ms optional enhanced profile.
FRONTIER_FRAME_MS=300
